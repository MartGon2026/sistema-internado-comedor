<item>
    <shape android:shape="rectangle">
        <solid android:color="#769AED" />
        <corners android:radius="100dp" />
    </shape>
</item>
<item android:bottom="2dp" android:top="6dp">
    <shape android:shape="rectangle">
        <solid android:color="#769AED" />
        <corners android:radius="100dp" />
    </shape>
</item>
</layer-list>

